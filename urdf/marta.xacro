<link name="l_feet_1">
  <inertial>
    <origin xyz="0.03170463685076108 3.7854833169481683e-07 -0.02917623775896855" rpy="0 0 0"/>
    <mass value="0.06770857635843897"/>
    <inertia ixx="2.2e-05" iyy="0.00011" izz="0.000119" ixy="0.0" iyz="0.0" ixz="-1e-06"/>
  </inertial>
  <visual>
    <origin xyz="0.017701 -0.039506 0.303802" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://marta_description/meshes/l_feet_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <xacro:if value="${'$(arg foot_collision)' == 'box'}">
      <!-- Mesma caixa envolvente da sola do STL (bbox medido da malha). -->
      <origin xyz="0.02445 0 -0.013" rpy="0 0 0"/>
      <geometry>
        <box size="0.1399 0.070 0.048"/>
      </geometry>
    </xacro:if>
    <xacro:unless value="${'$(arg foot_collision)' == 'box'}">
      <origin xyz="0.017701 -0.039506 0.303802" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://marta_description/meshes/l_feet_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </xacro:unless>
    <surface>
      <contact>
          <ode>
            <!-- Mesma fonte que o bloco <gazebo reference="*_feet_1"> em
                 marta.gazebo: antes havia 1e25/1e23 aqui e 1e6/1e4 la, valores
                 conflitantes para a mesma superficie. -->
            <kp>${contact_kp}</kp>
            <kd>${contact_kd}</kd>
          </ode>
        </contact>
    </surface>
  </collision>
</link>


